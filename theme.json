{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "760px",
            "wideSize": "1200px"
        },
        "color": {
            "palette": [
                {
                    "slug": "primary",
                    "name": "Primaire",
                    "color": "#1d4ed8"
                },
                {
                    "slug": "secondary",
                    "name": "Secondaire",
                    "color": "#0f766e"
                },
                {
                    "slug": "accent",
                    "name": "Accent",
                    "color": "#ea580c"
                },
                {
                    "slug": "dark",
                    "name": "Sombre",
                    "color": "#111827"
                },
                {
                    "slug": "light",
                    "name": "Clair",
                    "color": "#f8fafc"
                },
                {
                    "slug": "white",
                    "name": "Blanc",
                    "color": "#ffffff"
                }
            ]
        },
        "typography": {
            "fluid": true,
            "fontFamilies": [
                {
                    "slug": "system",
                    "name": "Police système",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Petit"
                },
                {
                    "slug": "medium",
                    "size": "1rem",
                    "name": "Normal"
                },
                {
                    "slug": "large",
                    "size": "1.5rem",
                    "name": "Grand"
                },
                {
                    "slug": "x-large",
                    "size": "2.5rem",
                    "name": "Très grand"
                }
            ]
        },
        "spacing": {
            "units": [
                "px",
                "rem",
                "%",
                "vw"
            ],
            "padding": true,
            "margin": true,
            "spacingSizes": [
                {
                    "slug": "xs",
                    "size": "0.5rem",
                    "name": "XS"
                },
                {
                    "slug": "s",
                    "size": "1rem",
                    "name": "S"
                },
                {
                    "slug": "m",
                    "size": "2rem",
                    "name": "M"
                },
                {
                    "slug": "l",
                    "size": "4rem",
                    "name": "L"
                },
                {
                    "slug": "xl",
                    "size": "6rem",
                    "name": "XL"
                }
            ]
        },
        "dimensions": {
            "minHeight": true
        },
        "border": {
            "radius": true
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--light)",
            "text": "var(--wp--preset--color--dark)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system)",
            "lineHeight": "1.6"
        },
        "elements": {
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "#ffffff"
                },
                "border": {
                    "radius": "6px"
                }
            }
        }
    }
}