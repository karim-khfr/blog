{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "720px",
            "wideSize": "1400px"
        },
        "color": {
            "custom": false,
            "defaultPalette": false,
            "palette": [
                {
                    "slug": "background",
                    "name": "Arrière-plan",
                    "color": "#F8F8FF"
                },
                {
                    "slug": "foreground",
                    "name": "Texte principal",
                    "color": "#0A0A23"
                },
                {
                    "slug": "accent",
                    "name": "Accent",
                    "color": "#3C24E3"
                },
                {
                    "slug": "surface",
                    "name": "Surface",
                    "color": "#FFFDF7"
                },
                {
                    "slug": "detail-rose",
                    "name": "Rose grisé",
                    "color": "#9D8189"
                },
                {
                    "slug": "detail-coral",
                    "name": "Corail",
                    "color": "#F67E7D"
                },
                {
                    "slug": "detail-pink",
                    "name": "Rose clair",
                    "color": "#FFB7B7"
                },
                {
                    "slug": "white",
                    "name": "Blanc",
                    "color": "#FFFFFF"
                }
            ]
        },
        "typography": {
            "customFontSize": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "slug": "heading",
                    "name": "Khand",
                    "fontFamily": "\"Khand\", sans-serif"
                },
                {
                    "slug": "body",
                    "name": "General Sans",
                    "fontFamily": "\"General Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "name": "Petit",
                    "size": "0.833rem"
                },
                {
                    "slug": "base",
                    "name": "Corps",
                    "size": "1rem"
                },
                {
                    "slug": "lead",
                    "name": "Chapeau",
                    "size": "1.2rem"
                },
                {
                    "slug": "heading-4",
                    "name": "Titre 4",
                    "size": "1.44rem"
                },
                {
                    "slug": "heading-3",
                    "name": "Titre 3",
                    "size": "1.728rem"
                },
                {
                    "slug": "heading-2",
                    "name": "Titre 2",
                    "size": "2.074rem"
                },
                {
                    "slug": "heading-1",
                    "name": "Titre 1",
                    "size": "2.488rem"
                }
            ]
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true,
            "units": [
                "px",
                "rem",
                "%",
                "vw"
            ],
            "spacingSizes": [
                {
                    "slug": "20",
                    "name": "Très petit",
                    "size": "0.5rem"
                },
                {
                    "slug": "30",
                    "name": "Petit",
                    "size": "1rem"
                },
                {
                    "slug": "40",
                    "name": "Moyen",
                    "size": "1.5rem"
                },
                {
                    "slug": "50",
                    "name": "Grand",
                    "size": "2rem"
                },
                {
                    "slug": "60",
                    "name": "Très grand",
                    "size": "4rem"
                },
                {
                    "slug": "70",
                    "name": "Section",
                    "size": "6rem"
                }
            ]
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "dimensions": {
            "minHeight": true
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--foreground)"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--40)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "var(--wp--preset--font-size--base)",
            "fontWeight": "500",
            "lineHeight": "1.6"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontWeight": "600",
                    "lineHeight": "1.2"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--heading-1)"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--heading-2)"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--heading-3)"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--heading-4)"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--lead)"
                }
            },
            "link": {
                "color": {
                    "text": "inherit"
                },
                "typography": {
                    "textDecoration": "none"
                }
            },
            "button": {
                "border": {
                    "radius": "6px"
                },
                "color": {
                    "background": "var(--wp--preset--color--accent)",
                    "text": "var(--wp--preset--color--background)"
                },
                "spacing": {
                    "padding": {
                        "top": "0.75rem",
                        "right": "1.5rem",
                        "bottom": "0.75rem",
                        "left": "1.5rem"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--body)",
                    "fontWeight": "600"
                }
            }
        }
    }
}